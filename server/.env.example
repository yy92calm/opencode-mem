# Secrets referenced as ${VAR} in config.yaml. Generate with: openssl rand -hex 32
LLM_API_KEY=your-llm-api-key-here
USER_DAVIDYANG_KEY=your-user-api-key-here

# Optional: override the worker's tz (must match config.yaml `tz:`).
# For local dev this is read from the host; set explicitly in Docker.
TZ=Asia/Shanghai

# Optional: restrict CORS to specific origins (comma-separated). Default: any.
CORS_ORIGIN=*
