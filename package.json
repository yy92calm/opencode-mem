{
  "name": "opencode-mem",
  "version": "1.0.0",
  "description": "Persistent memory plugin for OpenCode — context across sessions via Markdown files",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },

  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
